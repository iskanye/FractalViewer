<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        MinWidth="1000" MinHeight="600"
        x:Class="FractalViewer.MainWindow"
        Title="Fractal Viewer"
        Background="Black">
    <Grid>
        <Image 
            Name="image" 
            PointerWheelChanged="Scaling" 
            PointerPressed="DragStart" 
            PointerMoved="Drag"
            PointerReleased="DragEnd"
            Stretch="None"
            Grid.ColumnSpan="2"
        />
        <Slider
            Name="iterationsSlider"
            HorizontalAlignment="Left"
            Margin="10,10,0,0"
            VerticalAlignment="Top"
            Width="300"
            Maximum="2500"
            Minimum="10"
            Value="500" 
            ValueChanged="Rerender" 
            SmallChange="1"
        />        
        <Slider 
            Name="imaginarySlider" 
            HorizontalAlignment="Right" 
            Margin="10,10,10,0" 
            VerticalAlignment="Top" 
            Width="300" 
            Maximum="1" 
            Minimum="-1" 
            Value="0" 
            ValueChanged="Rerender"
        />
        <Label 
            Content="Количество итераций" 
            HorizontalAlignment="Left"
            Margin="320,20,0,0" 
            VerticalAlignment="Top"
            Foreground="White"          
            Height="50" 
        />
        <CheckBox 
            Name="juliaCheckBox" 
            Content="Множество Жюлиа" 
            HorizontalAlignment="Left" 
            Margin="16,47,0,0" 
            VerticalAlignment="Top" 
            Height="17" 
            Width="180" 
            FontSize="14" 
            Foreground="White"
        />
    </Grid>
</Window>
